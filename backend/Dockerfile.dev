# ============================================================
# FacturaExpress API - Imagen Docker de DESARROLLO
# Igual que el Dockerfile de produccion pero:
#   - instala tambien las dependencias de desarrollo (nodemon);
#   - NO define USER node, porque el codigo se monta como volumen y
#     el proceso necesita escribir sobre el arbol montado;
#   - arranca con recarga automatica.
# Se usa solo desde docker-compose.dev.yml (perfil "app").
# ============================================================

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=development

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 4000

CMD ["npm", "run", "dev"]
