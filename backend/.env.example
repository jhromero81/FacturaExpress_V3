# FacturaExpress API - Plantilla de variables de entorno
# Copie este archivo como .env y ajuste los valores segun su entorno.

# Entorno: development (local) o production (despliegue).
# En production: cookies con Secure, errores 500 sin detalles internos
# y JWT_SECRET es obligatorio (la API no arranca sin el).
NODE_ENV=development

# Puerto en el que escucha la API REST
PORT=4000

# Origen permitido por CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:3000

# Conexion a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Si la contrasena contiene caracteres especiales (#, espacios), use comillas dobles
DB_PASSWORD=tu_contrasena
DB_NAME=facturaexpress_apirest

# Secreto para firmar los tokens JWT (use un valor largo y unico)
JWT_SECRET=cambia_este_secreto_por_uno_seguro
# Tiempo de expiracion del token (ej: 8h, 1d)
JWT_EXPIRES_IN=8h
