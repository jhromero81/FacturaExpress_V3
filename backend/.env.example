# ============================================================
# FacturaExpress API - variables de entorno (plantilla)
# Copie este archivo como .env y ajuste los valores locales:
#   cp .env.example .env
# Nunca versiones el archivo .env (esta en .gitignore).
# ============================================================

# Entorno: development | production
NODE_ENV=development

# Puerto donde escucha la API
PORT=4000

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=facturaexpress_apirest
DB_USER=root
DB_PASSWORD=tu_password_aqui
# Credenciales con privilegios para restaurar respaldos (ejecutan DDL).
# Si se dejan vacias, se reutilizan las credenciales de runtime.
DB_RESTORE_USER=
DB_RESTORE_PASSWORD=
# Directorio de respaldos. Por defecto: <tmp>/facturaexpress_backups
# Se crea con permisos 0700 y los volcados con 0600 (contienen hashes).
BACKUP_DIR=

# ---------- JWT (sesion) ----------
# Obligatorio en produccion: minimo 32 caracteres y distinto del valor de
# ejemplo (la API se niega a arrancar si conserva la plantilla).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_una_cadena_aleatoria_larga
# Vigencia del token (8h, 1d, 30m...)
JWT_EXPIRES_IN=8h
# Emisor y audiencia que se firman y se exigen al verificar el token.
JWT_ISSUER=facturaexpress-api
JWT_AUDIENCE=facturaexpress-web

# ---------- CORS y proxy ----------
# Origen(es) autorizados del frontend; admite varios separados por coma.
CORS_ORIGIN=http://localhost:4200
# Detras de un proxy inverso: numero de saltos, 'loopback', 'false' o lista de IPs.
TRUST_PROXY=loopback

# ---------- Correo (opcional) ----------
# Si se dejan vacios, el envio de facturas por email se omite sin error.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Contrasenas del seed (opcional) ----------
# Si no se definen, el seed genera contrasenas aleatorias y las muestra
# una sola vez por consola. Deben cumplir la politica: minimo 8
# caracteres con minuscula, mayuscula y digito.
SEED_ADMIN_PASSWORD=
SEED_VENDEDOR_PASSWORD=
SEED_CONTADOR_PASSWORD=

# ---------- Pruebas de aceptacion E2E (opcional) ----------
# Credenciales que usa scripts/pruebas-aceptacion.js contra una API viva.
E2E_BASE_URL=http://127.0.0.1:4000
E2E_NIT=900.123.456-7
E2E_PASSWORD=
E2E_VENDEDOR_NIT=80.987.654-3
E2E_VENDEDOR_PASSWORD=