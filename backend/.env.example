# ============================================================
# FacturaExpress API - Plantilla de variables de entorno
# Copie este archivo como .env y ajuste los valores.
#   cp .env.example .env
# ============================================================

# --- Entorno ---
# development | production (en produccion JWT_SECRET es obligatorio)
NODE_ENV=development

# --- Servidor HTTP ---
PORT=4000

# --- CORS ---
# Origen del frontend autorizado a enviar credenciales (cookies)
CORS_ORIGIN=http://localhost:4200

# --- JWT ---
# Secreto para firmar los tokens. En produccion use un valor
# largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=cambie_este_secreto_por_un_valor_aleatorio_largo
# Duracion de la sesion (formatos validos: ms, s, m, h, d)
JWT_EXPIRES_IN=8h

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=facturaexpress_apirest

# --- Correo (opcional) ---
# Si se definen MAIL_USERNAME y MAIL_PASSWORD se habilita el envio
# de correo; de lo contrario el servicio queda en modo simulado.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
