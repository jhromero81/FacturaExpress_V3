# ============================================================
# FacturaExpress - variables de entorno para Docker Compose
# Copie este archivo como .env en la raiz del proyecto y defina
# los secretos antes de ejecutar:  docker compose up --build
# ============================================================

# ---------- Secretos obligatorios ----------
MYSQL_ROOT_PASSWORD=cambia_la_clave_root_de_mysql
DB_PASSWORD=cambia_la_clave_del_usuario_de_la_api
# Obligatorio en produccion: minimo 32 caracteres y distinto de este
# valor de ejemplo (la API se niega a arrancar si conserva la plantilla).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_una_cadena_aleatoria_larga

# ---------- Opcionales (valores por defecto) ----------
DB_NAME=facturaexpress_apirest
DB_USER=facturaexpress
# Credenciales con privilegios para restaurar respaldos. Si se dejan
# vacias, se reutilizan las credenciales del usuario de runtime.
DB_RESTORE_USER=
DB_RESTORE_PASSWORD=

JWT_EXPIRES_IN=8h
JWT_ISSUER=facturaexpress-api
JWT_AUDIENCE=facturaexpress-web

# Origenes permitidos por CORS; admite varios separados por coma.
CORS_ORIGIN=http://localhost:4200

# La API corre detras de nginx: numero de saltos a confiar en X-Forwarded-For
TRUST_PROXY=1

# ---------- Contrasenas del seed (recomendado definirlas) ----------
# Si se dejan vacias, el seed genera contrasenas aleatorias y las muestra
# una sola vez en el log del contenedor. Minimo 8 caracteres con
# minuscula, mayuscula y digito.
SEED_ADMIN_PASSWORD=
SEED_VENDEDOR_PASSWORD=
SEED_CONTADOR_PASSWORD=