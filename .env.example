# ============================================================
# FacturaExpress - Variables para Docker Compose (raiz)
# Copie este archivo como .env y defina valores seguros:
#   cp .env.example .env
# ============================================================

# Clave root del contenedor MySQL (solo administracion interna)
MYSQL_ROOT_PASSWORD=cambie_esta_clave_root

# Base de datos de la aplicacion
DB_NAME=facturaexpress_apirest
DB_USER=facturaexpress
DB_PASSWORD=cambie_esta_clave

# Secreto de firma JWT (obligatorio). Genere uno con:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origen autorizado del frontend (con credenciales/cookies)
CORS_ORIGIN=http://localhost:4200
